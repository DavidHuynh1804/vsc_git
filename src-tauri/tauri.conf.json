{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vsc_git",
  "version": "0.1.0",
  "identifier": "io.github.davidhuynh1804.vscgit",
  "build": {
    "beforeDevCommand": "pnpm sidecars && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm sidecars:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vsc_git",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost blob: data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NDU3RkM4MDNGMkYzNUYKUldSZjgvSUR5SDlGQ0VBREw4OWM0RVJJekFxQk1jYzJUOFNEZVRRWEdlN1FxSmdhbTdSVnI0UkoK",
      "endpoints": [
        "https://github.com/DavidHuynh1804/vsc_git/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/vsc-git-askpass",
      "binaries/vsc-git-sequence-editor"
    ]
  }
}
